# ---- Web server -------------------------------------------------------------
PORT=3000
# Public URL of THIS backend, no trailing slash. Steam redirects users back here.
# Local: http://localhost:3000    Live: https://your-domain.com
BASE_URL=http://localhost:3000
NODE_ENV=development
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# Only set this if the frontend is hosted on a DIFFERENT origin than the backend
# (e.g. static site on Firebase Hosting). Leave empty when Express serves /public.
CLIENT_ORIGIN=

# ---- Steam ------------------------------------------------------------------
# Free key: https://steamcommunity.com/dev/apikey  (needed to get name + avatar)
STEAM_API_KEY=

# ---- Firebase ---------------------------------------------------------------
# Path to the service-account JSON (Firebase console > Project settings >
# Service accounts > Generate new private key). NEVER commit this file.
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
# A driver whose last heartbeat is older than this is treated as signed out.
DRIVER_STALE_MINUTES=30
